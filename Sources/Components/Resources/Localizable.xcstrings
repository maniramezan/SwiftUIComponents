    },
    "Error: %@" : {
      "comment" : "Accessibility label for an inline error banner. The %@ is the error message; the \"Error\" prefix conveys the error nature to VoiceOver users, who cannot perceive the red tint.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error: %@"
          }
        }
      }
    },
    "Loading" : {
      "comment" : "Accessibility value announced on a button while it is in its loading state and temporarily disabled.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loading"
          }
        }
      }
    },
    "Next page" : {
