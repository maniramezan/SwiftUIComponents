        }
      }
    },
    "Page %lld of %lld, %@" : {
      "comment" : "Accessibility value announced for the page indicator. The first %lld is the 1-based page number, the second %lld is the total page count, and %@ is the title of the current page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page %1$lld of %2$lld, %3$@"
          }
        }
      }
    },
